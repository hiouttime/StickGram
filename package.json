{
  "name": "sticker.tgda.sh",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "tsx --tsconfig tsconfig.app.json --test tests/*/*.test.ts",
    "format": "prettier --write .prettierrc.json src tests docs \"*.{json,ts,md}\""
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "@microsoft/clarity": "^1.0.2",
    "@vicons/ionicons5": "^0.12",
    "fflate": "^0.8.3",
    "naive-ui": "^2.40",
    "nanoid": "^5",
    "pinia": "^2",
    "vue": "^3.5",
    "vue-i18n": "^11",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.6",
    "vite": "^6",
    "vue-tsc": "^2",
    "wrangler": "^4"
  }
}
